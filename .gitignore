# Built daemon and its runtime, produced by firmware/build-meshtasticd-android.sh
app/src/main/jniLibs/arm64-v8a/*.so

# Cross-built dependencies and their sources
firmware/android-prefix/
firmware/deps-src/
firmware/meshcore/android-prefix/
firmware/meshcore/deps-src/

# Signing material. Never commit these.
keystore.properties
*.jks
*.keystore

# Gradle and Android Studio state. gradle/wrapper/gradle-wrapper.jar is committed
# on purpose so that a fresh clone can run ./gradlew.
.gradle/
build/
app/build/
local.properties
captures/
.idea/
*.iml

# Editors and desktops
.vscode/
.DS_Store

# Signed release APKs from Android Studio
app/release/

# Agent docs
AGENT/

# Agent handoff notes, working material rather than part of the project
AGENT-BRIEF.md
AGENT-BRIEF-2.0.0.md
make-handoff.sh

# Github files
github
github.pub