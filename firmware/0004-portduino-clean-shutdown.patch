 #include <ErriezCRC32.h>
 #include <Utility.h>
 #include <assert.h>
@@ -1435,4 +1436,43 @@
     initRegion();
     if (service)
         service->reloadConfig(changes);
 }
+
+// Clean shutdown for hosts that stop the daemon with a signal: Meshdroid's Stop
+// and Restart, and systemd on Linux. Portduino installs no handler, so the default
+// action ends the process wherever it happens to be, including part way through
+// writing prefs. The handler only records the signal; the save runs from loop(),
+// where nothing else is touching those files.
+//
+// SIGINT is left alone on purpose. WiFiServer::write() raises it when the
+// unimplemented Print path is reached, and that has to stay a visible crash
+// rather than look like a clean exit.
+static volatile sig_atomic_t portduinoShutdownSignal = 0;
+
+static void portduinoShutdownHandler(int sig)
+{
+    portduinoShutdownSignal = sig;
+}
+
+void portduinoInstallShutdownHandler()
+{
+    struct sigaction sa = {};
+    sa.sa_handler = portduinoShutdownHandler;
+    sigemptyset(&sa.sa_mask);
+    sigaction(SIGTERM, &sa, NULL);
+}
+
+void portduinoCheckShutdown()
+{
+    static bool installed = false;
+    if (!installed) {
+        portduinoInstallShutdownHandler();
+        installed = true;
+    }
+    if (!portduinoShutdownSignal)
+        return;
+    LOG_INFO("Signal %d received, saving node data and exiting", (int)portduinoShutdownSignal);
+    if (nodeDB)
+        nodeDB->saveToDisk();
+    exit(0);
+}
