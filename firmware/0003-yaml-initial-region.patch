+// Mirrors AdminModule's set_config(lora) region path and the wasm port's wasm_set_region():
+// first-region keygen + enable tx -> initRegion() -> reloadConfig (reconfigure radio + persist).
+void portduinoApplyInitialRegion()
+{
+    const std::string &want = portduino_config.initial_region;
+    if (want.empty())
+        return;
+    if (config.lora.region != meshtastic_Config_LoRaConfig_RegionCode_UNSET) {
+        LOG_DEBUG("config.yaml Lora.Region=%s ignored: node already has a region", want.c_str());
+        return;
+    }
+    const RegionInfo *found = nullptr;
+    for (const RegionInfo *r = regions; r->code != meshtastic_Config_LoRaConfig_RegionCode_UNSET; r++) {
+        if (r->name && strcasecmp(r->name, want.c_str()) == 0) {
+            found = r;
+            break;
+        }
+    }
+    if (!found) {
+        LOG_ERROR("config.yaml Lora.Region '%s' is not a known region code (e.g. US, EU_868, EU_433, ANZ, JP)", want.c_str());
+        return;
+    }
+    meshtastic_Config_LoRaConfig validated = config.lora;
+    validated.region = found->code;
+    validated.tx_enabled = true;
+    if (!(RadioInterface::validateConfigRegion(validated) && RadioInterface::validateConfigLora(validated))) {
+        LOG_ERROR("config.yaml Lora.Region '%s' failed validation", want.c_str());
+        return;
+    }
+    LOG_INFO("Applying initial LoRa region %s from config.yaml", found->name);
+    int changes = SEGMENT_CONFIG;
+#if !(MESHTASTIC_EXCLUDE_PKI_KEYGEN || MESHTASTIC_EXCLUDE_PKI)
+    // Minting the key moves our node num with it, so persist devicestate + the node DB too.
+    config.lora = validated; // ensurePkiIdentity() checks the region before minting
+    if (nodeDB && nodeDB->ensurePkiIdentity())
+        changes |= SEGMENT_DEVICESTATE | SEGMENT_NODEDATABASE;
+#else
+    config.lora = validated;
+#endif
+    initRegion();
+    if (service)
+        service->reloadConfig(changes);
+}
