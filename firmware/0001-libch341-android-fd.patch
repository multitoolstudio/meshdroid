+#ifdef __linux__
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <stddef.h>
+/* Android: receive a usbfs fd over an abstract-namespace Unix socket (SCM_RIGHTS).
+ * The app's foreground service listens on LocalServerSocket(name) and sends the
+ * fd from UsbDeviceConnection.getFileDescriptor(). */
+static int pinedio_recv_fd_from_socket(const char *name) {
+  int sock = socket(AF_UNIX, SOCK_STREAM, 0);
+  if (sock < 0) return -1;
+  struct sockaddr_un addr;
+  memset(&addr, 0, sizeof(addr));
+  addr.sun_family = AF_UNIX;
+  addr.sun_path[0] = '\0';                       /* abstract namespace */
+  strncpy(addr.sun_path + 1, name, sizeof(addr.sun_path) - 2);
+  socklen_t len = (socklen_t)(offsetof(struct sockaddr_un, sun_path) + 1 + strlen(name));
+  if (connect(sock, (struct sockaddr *)&addr, len) < 0) {
+    fprintf(stderr, "connect(@%s) failed\n", name);
+    close(sock);
+    return -1;
+  }
+  char data;
+  struct iovec iov = {.iov_base = &data, .iov_len = 1};
+  union { struct cmsghdr hdr; char buf[CMSG_SPACE(sizeof(int))]; } ctrl;
+  struct msghdr msg;
+  memset(&msg, 0, sizeof(msg));
+  msg.msg_iov = &iov;
+  msg.msg_iovlen = 1;
+  msg.msg_control = ctrl.buf;
+  msg.msg_controllen = sizeof(ctrl.buf);
+  int fd = -1;
+  if (recvmsg(sock, &msg, 0) >= 0) {
+    for (struct cmsghdr *c = CMSG_FIRSTHDR(&msg); c != NULL; c = CMSG_NXTHDR(&msg, c)) {
+      if (c->cmsg_level == SOL_SOCKET && c->cmsg_type == SCM_RIGHTS) {
+        memcpy(&fd, CMSG_DATA(c), sizeof(int));
+      }
+    }
+  }
+  close(sock);
+  return fd;
+}
